# Worker Dockerfile for PDF Processing
# Optimized for CPU-intensive PDF/image processing

# ============================================================================
# Stage 1: Build
# ============================================================================
FROM node:20-alpine AS builder

# Install build dependencies for native modules (canvas, etc.)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    pkgconf \
    cairo-dev \
    pango-dev \
    libjpeg-turbo-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Drop devDependencies (typescript, ts-node, @types/*) — keeps compiled
# native modules (canvas) without rebuilding them in the final stage
RUN npm prune --omit=dev

# ============================================================================
# Stage 2: Production Worker
# ============================================================================
FROM node:20-alpine

# Install runtime dependencies
# - Poppler (pdftoppm) - PRIMARY converter: native C++, handles 200MB+ JPEG2000
#   brochures that exhaust the mupdf WASM heap (malloc failed → skipped pages)
# - GraphicsMagick + Ghostscript for pdf2pic (PDF to image conversion)
# - Cairo + Pango for canvas
RUN apk add --no-cache \
    poppler-utils \
    graphicsmagick \
    ghostscript \
    cairo \
    pango \
    libjpeg-turbo \
    giflib \
    librsvg \
    pixman

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# /app itself must be writable by nodejs — the worker mkdirs temp/uploads
# subpaths at runtime. Chown of the (empty) dir costs nothing.
RUN chown nodejs:nodejs /app

# Copy with ownership set at COPY time — a separate `RUN chown -R /app`
# would duplicate every copied file into a new layer (+327MB measured)
COPY --chown=nodejs:nodejs package*.json ./

# Copy node_modules from builder
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy built application from builder
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Copy data files (GeoJSON, etc.)
COPY --from=builder --chown=nodejs:nodejs /app/data ./data

# Create temp directories for PDF processing (chown only these, not /app)
RUN mkdir -p /app/temp /app/uploads && chown nodejs:nodejs /app/temp /app/uploads

# Switch to non-root user
USER nodejs

# Environment
ENV NODE_ENV=production

# Worker-specific memory settings
# Allow Node.js to use more memory for PDF processing
# GC will manage memory, not kill the process
ENV NODE_OPTIONS="--max-old-space-size=6144 --expose-gc"

# Health check - worker doesn't expose HTTP, so just check process
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -f "node dist/worker/index.js" || exit 1

# Start the worker
CMD ["node", "dist/worker/index.js"]
