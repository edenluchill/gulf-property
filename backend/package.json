{
  "name": "pinzos-backend",
  "version": "1.0.0",
  "description": "Backend API for Pinzos Dubai off-plan properties platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:8gb": "node --max-old-space-size=8192 ./node_modules/.bin/ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File ./clean-start.ps1",
    "dev:ps": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "build": "tsc --project tsconfig.production.json",
    "build:strict": "tsc",
    "start": "node dist/index.js",
    "kill": "powershell -ExecutionPolicy Bypass -Command \"Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }; Write-Host 'Port 3000 cleared' -ForegroundColor Green\"",
    "migrate": "ts-node src/db/migrate.ts",
    "migrate:developer": "ts-node src/db/migrate-developer-submissions.ts",
    "migrate:payment-plans": "ts-node src/db/migrate-payment-plans.ts",
    "import:pois": "ts-node scripts/import-osm-pois-from-file.ts",
    "import:analytics": "ts-node src/db/import-dubai-analytics.ts",
    "import:dld-areas": "ts-node src/db/import-dld-areas.ts",
    "import:rent-contracts": "ts-node src/db/import-dld-rent-contracts.ts",
    "calculate:area-metrics": "ts-node -e \"require('./src/db/pool').default.query('SELECT calculate_area_rolling_metrics(CURRENT_DATE)').then(() => process.exit(0))\"",
    "seed": "ts-node src/db/seed.ts",
    "cleanup-temp": "ts-node cleanup-temp-folders.ts",
    "cleanup-r2": "ts-node cleanup-r2-temp-files.ts"
  },
  "keywords": [
    "dubai",
    "real-estate",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "3.986.0",
    "@geoman-io/leaflet-geoman-free": "^2.19.0",
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/google-genai": "^2.1.7",
    "@langchain/langgraph": "^1.0.14",
    "@supabase/supabase-js": "^2.93.3",
    "@tmcw/togeojson": "^7.1.2",
    "@types/multer": "^2.0.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@xmldom/xmldom": "^0.8.11",
    "axios": "^1.13.2",
    "canvas": "^3.2.1",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mupdf": "^1.27.0",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.1.3",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.11.3",
    "pg-copy-streams": "^7.0.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
