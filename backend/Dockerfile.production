# Production-optimized Dockerfile for Pinzos Backend
# Multi-stage build for smaller image size

# ============================================================================
# Stage 1: Build
# ============================================================================
FROM node:20-alpine AS builder

# Install build dependencies for native modules (canvas, etc.)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    pkgconf \
    cairo-dev \
    pango-dev \
    libjpeg-turbo-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build TypeScript (with production config - relaxed checking)
RUN npm run build

# Drop devDependencies (typescript, ts-node, @types/*) — keeps compiled
# native modules (canvas) without rebuilding them in the final stage
RUN npm prune --omit=dev

# ============================================================================
# Stage 2: Production
# ============================================================================
FROM node:20-alpine

# Install runtime dependencies
# - GraphicsMagick + Ghostscript for pdf2pic
# - Cairo + Pango for canvas
RUN apk add --no-cache \
    graphicsmagick \
    ghostscript \
    cairo \
    pango \
    libjpeg-turbo \
    giflib \
    librsvg \
    pixman

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# /app itself must be writable by nodejs — the app mkdirs voice-debug-logs,
# uploads etc. at runtime. Chown of the (empty) dir costs nothing.
RUN chown nodejs:nodejs /app

# Copy with ownership set at COPY time — a separate `RUN chown -R /app`
# would duplicate every copied file into a new layer (+327MB measured)
COPY --chown=nodejs:nodejs package*.json ./

# Copy node_modules from builder (includes canvas with native bindings)
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy built application from builder
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Copy data files (GeoJSON, KML, etc.)
COPY --from=builder --chown=nodejs:nodejs /app/data ./data

# Switch to non-root user
USER nodejs

# Environment
ENV NODE_ENV=production
ENV PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:${PORT:-3000}/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Expose port
EXPOSE 3000

# Start the application
CMD ["node", "dist/index.js"]
